# Google Cloud project and deployment metadata
PROJECT_ID=your-gcp-project-id
REGION=us-central1
REPOSITORY_NAME=video-processing-service
SERVICE_NAME=video-processing-service
SERVICE_VERSION=local
NODE_ENV=development

# Video processing configuration
RAW_VIDEO_BUCKET_NAME=atmuri-yt-raw-videos
PROCESSED_VIDEO_BUCKET_NAME=atmuri-yt-processed-videos
PROCESSING_MAX_ATTEMPTS=3

# Transcription (Speech-to-Text v2)
AUDIO_WORK_BUCKET_NAME=atmuri-yt-audio-work
TRANSCRIPTS_BUCKET_NAME=atmuri-yt-transcripts
TRANSCRIPTION_TOPIC_NAME=transcription-jobs
SPEECH_TO_TEXT_MODEL=long
SPEECH_TO_TEXT_LANGUAGE=en-US
SPEECH_LOCATION=us-central1
RAW_TRANSCRIPT_PREFIX=raw
NORMALIZED_TRANSCRIPT_PREFIX=normalized
ENABLE_TRANSCRIPTION=false
# LAUNCH BLOCKER: STANDARD is the test default (~$0.016/min, minutes-scale).
# Accepted: STANDARD | DYNAMIC_BATCHING. Unrecognized values refuse to start.
# Switch to DYNAMIC_BATCHING (~$0.003/min, 24h ceiling) before production.
SPEECH_PROCESSING_STRATEGY=STANDARD
RECONCILE_STALE_AFTER_MS=1800000

# Optional: path to service account credentials for local development
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
