rules_version = '2';

// Firestore security rules for CloudScribe AI.
//
// Ownership model:
//   videos/{videoId}              -> field `uid` is the Firebase Auth owner
//   videos/{videoId}/transcripts  -> field `userId` mirrors the owner (when present)
//
// All writes use the Admin SDK (Cloud Functions + video-processing-service) and
// bypass these rules. The web client only reads via the Firebase client SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /videos/{videoId} {
      // Owner may read their own video metadata (watch page onSnapshot).
      allow read: if isSignedIn()
                  && resource.data.uid == request.auth.uid;
      allow write: if false;

      match /transcripts/{transcriptId} {
        // Parent-video ownership check (not resource.data.userId) so queries
        // like orderBy("createdAt") without a userId filter still succeed, and
        // legacy transcript docs missing userId remain covered.
        allow read: if isSignedIn()
                    && videoOwnedByCaller(videoId);
        allow write: if false;
      }
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function videoOwnedByCaller(videoId) {
      return get(/databases/$(database)/documents/videos/$(videoId)).data.uid
             == request.auth.uid;
    }
  }
}
