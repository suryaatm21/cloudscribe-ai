{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "env": {
    "ENABLE_CODE_SECURITY_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(gcloud config list *)",
      "Bash(gcloud projects describe *)",
      "Bash(gcloud projects list *)",
      "Bash(gcloud projects get-iam-policy *)",
      "Bash(gcloud services list *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run services list *)",
      "Bash(gcloud run services get-iam-policy *)",
      "Bash(gcloud run revisions describe *)",
      "Bash(gcloud run revisions list *)",
      "Bash(gcloud functions describe *)",
      "Bash(gcloud functions list *)",
      "Bash(gcloud functions get-iam-policy *)",
      "Bash(gcloud pubsub topics describe *)",
      "Bash(gcloud pubsub topics list *)",
      "Bash(gcloud pubsub topics get-iam-policy *)",
      "Bash(gcloud pubsub subscriptions describe *)",
      "Bash(gcloud pubsub subscriptions list *)",
      "Bash(gcloud pubsub subscriptions get-iam-policy *)",
      "Bash(gcloud scheduler jobs describe *)",
      "Bash(gcloud scheduler jobs list *)",
      "Bash(gcloud builds describe *)",
      "Bash(gcloud builds list *)",
      "Bash(gcloud builds triggers describe *)",
      "Bash(gcloud builds triggers list *)",
      "Bash(gcloud storage buckets describe *)",
      "Bash(gcloud storage buckets list *)",
      "Bash(gcloud storage buckets get-iam-policy *)",
      "Bash(gcloud storage buckets notifications describe *)",
      "Bash(gcloud storage buckets notifications list *)",
      "Bash(gcloud storage objects describe *)",
      "Bash(gcloud storage objects list *)",
      "Bash(gcloud artifacts repositories describe *)",
      "Bash(gcloud artifacts repositories list *)",
      "Bash(gcloud artifacts repositories get-iam-policy *)",
      "Bash(gcloud artifacts docker images describe *)",
      "Bash(gcloud artifacts docker images list *)",
      "Bash(gcloud iam service-accounts describe *)",
      "Bash(gcloud iam service-accounts list *)",
      "Bash(gcloud iam service-accounts get-iam-policy *)",
      "Bash(gcloud firestore databases describe *)",
      "Bash(gcloud firestore databases list *)",
      "Bash(gcloud firestore indexes composite describe *)",
      "Bash(gcloud firestore indexes composite list *)",
      "Bash(gcloud logging metrics describe *)",
      "Bash(gcloud logging metrics list *)",
      "Bash(gcloud monitoring policies describe *)",
      "Bash(gcloud monitoring policies list *)",
      "Bash(gcloud billing budgets describe *)",
      "Bash(gcloud billing budgets list *)"
    ],
    "deny": [
      "Bash(firebase *)",
      "Bash(npx firebase *)",
      "Bash(npx firebase-tools *)",
      "Bash(gsutil *)",
      "Bash(npm *deploy*)",
      "Bash(*deploy.sh*)",
      "Bash(*setup-transcription-infra.sh*)",
      "Bash(docker push *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh auth *)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/configstore/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gcloud-readonly.py\""
          }
        ]
      }
    ]
  }
}
